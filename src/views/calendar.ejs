<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Moodly - 캘린더</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"/>
  <link rel="stylesheet" href="/modal.css"/>
  <link rel="stylesheet" href="/calendar.css"/>
  <style>
    /* ================================================================ */
    /* ✨ [수정] 버튼을 글자 뒤에 인라인으로 붙이고 초록색 감성 유지 */
    /* ================================================================ */
    .more-less-btn {
      background: none;
      border: none;
      color: #6b8f5e; /* Moodly 시그니처 초록색 */
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      padding: 0;
      margin-left: 6px; /* 글자(...)와 버튼 사이의 간격 */
      display: inline-block; /* 줄바꿈 없이 글자 뒤에 바로 붙도록 인라인 처리 */
      vertical-align: baseline;
    }
    .more-less-btn:hover {
      text-decoration: underline;
      color: #5a7a4e;
    }

    /* 일기 본문 영역 가로 스크롤 완전히 없애기 */
    .entry-content {
      word-break: break-all;      
      overflow-wrap: break-word;  
      white-space: pre-wrap;      /* pre-wrap을 유지해야 접혔을 때 인라인 버튼이 한 흐름으로 묶입니다 */
      max-width: 100%;            
    }
    /* ================================================================ */
  </style>
</head>
<body>

<div class="app-container">
  <%- include('partials/header') %>
</div>

<div class="cal-container">
  <div class="calendar-card">
    <div class="cal-header">
      <button class="cal-nav-btn" id="prevBtn">&#8249;</button>
      <h2 id="calTitle"></h2>
      <button class="cal-nav-btn" id="nextBtn">&#8250;</button>
    </div>
    <div class="cal-grid" id="calGrid">
      <div class="day-header sun">일</div>
      <div class="day-header">월</div>
      <div class="day-header">화</div>
      <div class="day-header">수</div>
      <div class="day-header">목</div>
      <div class="day-header">금</div>
      <div class="day-header sat">토</div>
    </div>
  </div>

  <div class="detail-panel">
    <div class="detail-empty" id="detailEmpty">날짜를 선택하면<br/>일기 내용이 표시됩니다 📖</div>

    <div class="emotion-card" id="emotionCard">
      <div class="big-emoji" id="detailEmoji"></div>
      <div class="emotion-label" id="detailEmotion"></div>
      <div class="diary-date" id="detailDate"></div>
    </div>

    <div class="diary-card" id="diaryCard">
      <h3>일기</h3>
      <div id="diaryContent"></div>
    </div>

    <div class="diary-edit-card" id="diaryEditCard">
      <h3>일기 수정</h3>
      <textarea id="diaryEditInput"></textarea>
    </div>

    <div class="no-diary-msg" id="noDiaryMsg">
      <div class="date-label" id="noDiaryDate"></div>
      <a href="#" class="write-btn" id="writeDiaryBtn">+ 일기 쓰기</a>
    </div>

    <div class="detail-actions" id="detailActions">
      <button class="btn-delete" id="deleteBtn">삭제하기</button>
      <button class="btn-edit" id="editBtn">수정하기</button>
    </div>

    <div class="detail-actions" id="editActions">
      <button class="btn-delete" id="cancelBtn">취소</button>
      <button class="btn-edit" id="saveBtn">저장하기</button>
    </div>
  </div>
</div>

<script>
  const isLoggedIn = "<%= user ? 'true' : 'false' %>" === "true";
  if (!isLoggedIn) {
    window.addEventListener('load', () => {
      if (typeof openLogin === 'function') openLogin();
    });
  }

  let diaryMap = {};
  let currentYear, currentMonth;
  let currentDiaryId = null;
  let isEditMode = false;
  let selectedDateKey = null;

  function pad(n) { return String(n).padStart(2, '0'); }
  function toKey(y, m, d) { return `${y}-${pad(m)}-${pad(d)}`; }

  async function loadAndBuildCalendar(year, month) {
    currentYear = year;
    currentMonth = month;
    document.getElementById('calTitle').textContent = `${year}년 ${month}월`;

    try {
      const response = await fetch(`/calendar?year=${year}&month=${month}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const result = await response.json();
      diaryMap = result.diaryMap || {};
    } catch (e) {
      console.error("실시간 데이터 조회 실패:", e);
      diaryMap = {};
    }

    const grid = document.getElementById('calGrid');
    while (grid.children.length > 7) grid.removeChild(grid.lastChild);

    const firstDay = new Date(year, month - 1, 1).getDay();
    const lastDate = new Date(year, month, 0).getDate();
    const prevLastDate = new Date(year, month - 1, 0).getDate();
    const today = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth() + 1, today.getDate());

    for (let i = firstDay - 1; i >= 0; i--) {
      const pm = month - 1 === 0 ? 12 : month - 1;
      const py = month - 1 === 0 ? year - 1 : year;
      grid.appendChild(makeDayCell(py, pm, prevLastDate - i, true));
    }
    for (let d = 1; d <= lastDate; d++) {
      const cell = makeDayCell(year, month, d, false);
      if (toKey(year, month, d) === todayKey) cell.classList.add('today');
      grid.appendChild(cell);
    }
    const total = grid.children.length - 7;
    const remaining = total % 7 === 0 ? 0 : 7 - (total % 7);
    for (let d = 1; d <= remaining; d++) {
      const nm = month + 1 > 12 ? 1 : month + 1;
      const ny = month + 1 > 12 ? year + 1 : year;
      grid.appendChild(makeDayCell(ny, nm, d, true));
    }
  }

  function makeDayCell(year, month, day, otherMonth) {
    const cell = document.createElement('div');
    cell.classList.add('day-cell');
    if (otherMonth) cell.classList.add('other-month');

    const dow = new Date(year, month - 1, day).getDay();
    if (dow === 0) cell.classList.add('sun');
    if (dow === 6) cell.classList.add('sat');

    const key = toKey(year, month, day);
    const numEl = document.createElement('div');
    numEl.className = 'day-num';
    numEl.textContent = day;
    cell.appendChild(numEl);

    if (diaryMap[key]) {
      const em = document.createElement('div');
      em.className = 'emoji-icon';
      em.textContent = diaryMap[key].emoji;
      cell.appendChild(em);
    }

    if (!otherMonth) {
      cell.addEventListener('click', () => selectDay(cell, key, year, month, day));
    }
    return cell;
  }

  let selectedCell = null;

  function selectDay(cell, key, year, month, day) {
    if (selectedCell) selectedCell.classList.remove('selected');
    cell.classList.add('selected');
    selectedCell = cell;
    selectedDateKey = key;
    exitEditMode();

    const dateStr = `${year}년 ${month}월 ${day}일`;
    document.getElementById('detailEmpty').style.display = 'none';

    const data = diaryMap[key];
    if (data) {
      const ec = document.getElementById('emotionCard');
      ec.classList.add('visible');
      ec.style.background = data.colorCode || '#f5f5e8';
      document.getElementById('detailEmoji').textContent = data.emoji;
      document.getElementById('detailEmotion').textContent = data.emotion;
      document.getElementById('detailDate').textContent = `${dateStr} 에 작성됨`;

      const diaryCard = document.getElementById('diaryCard');
      diaryCard.classList.add('visible');
      const diaryContent = document.getElementById('diaryContent');
      diaryContent.innerHTML = '';
      currentDiaryId = null;

      data.entries.forEach((entry, idx) => {
        if (idx > 0) {
          const hr = document.createElement('hr');
          hr.className = 'entry-divider';
          diaryContent.appendChild(hr);
        }

        const entryEl = document.createElement('div');
        entryEl.className = 'diary-entry';
        entryEl.dataset.id = entry.diaryId;
        entryEl.dataset.content = entry.content;

        const rawContent = entry.content;
        const isLong = rawContent.length > 50;
        const displayContent = isLong ? rawContent.substring(0, 50) + '...' : rawContent;

        // ★ [구조 변경] 더보기 버튼이 entry-content div 외부가 아니라 내부로 들어가 글자 바로 뒤에 붙도록 바꿈
        entryEl.innerHTML = `
          <div class="entry-meta">
            <span>${entry.emoji} ${entry.emotion}</span>
            <span class="entry-time">${entry.time}</span>
          </div>
          <div class="entry-content">${displayContent}${isLong ? `<button class="more-less-btn" type="button">더보기</button>` : ''}</div>
        `;

        if (isLong) {
          const btn = entryEl.querySelector('.more-less-btn');
          const contentDiv = entryEl.querySelector('.entry-content');
          let isOpen = false;

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!isOpen) {
              // 전체 내용을 뿌릴 때 엔터를 <br>로 치환하고 간략히 버튼을 세팅합니다.
              contentDiv.innerHTML = rawContent.replace(/\n/g, '<br>') + `<button class="more-less-btn" type="button">간략히</button>`;
              isOpen = true;
            } else {
              // 다시 접을 때 50자 자르고 더보기 버튼을 뒤에 다시 붙여줍니다.
              contentDiv.innerHTML = rawContent.substring(0, 50) + '...' + `<button class="more-less-btn" type="button">더보기</button>`;
              isOpen = false;
            }
            // HTML 구조가 완전히 새로고침되므로, 변경된 상태의 버튼 객체를 실시간으로 다시 추적해 이벤트를 새로 매핑합니다.
            bindToggleEvent();
          });

          // 무한 루프나 참조 끊김을 방지하기 위해 버튼 이벤트를 재매핑하는 내부 헬퍼 함수
          function bindToggleEvent() {
            const currentBtn = entryEl.querySelector('.more-less-btn');
            currentBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              if (!isOpen) {
                contentDiv.innerHTML = rawContent.replace(/\n/g, '<br>') + `<button class="more-less-btn" type="button">간략히</button>`;
                isOpen = true;
              } else {
                contentDiv.innerHTML = rawContent.substring(0, 50) + '...' + `<button class="more-less-btn" type="button">더보기</button>`;
                isOpen = false;
              }
              bindToggleEvent(); // 재귀적으로 바인딩을 유지
            });
          }
        }

        entryEl.addEventListener('click', () => {
          diaryContent.querySelectorAll('.diary-entry').forEach(el => el.classList.remove('selected'));
          entryEl.classList.add('selected');
          currentDiaryId = entry.diaryId;
          document.getElementById('detailActions').classList.add('visible');
        });

        diaryContent.appendChild(entryEl);
      });

      document.getElementById('detailActions').classList.remove('visible');
      document.getElementById('noDiaryMsg').classList.remove('visible');
      document.getElementById('diaryEditCard').classList.remove('visible');
      document.getElementById('editActions').classList.remove('visible');

    } else {
      currentDiaryId = null;
      document.getElementById('emotionCard').classList.remove('visible');
      document.getElementById('diaryCard').classList.remove('visible');
      document.getElementById('detailActions').classList.remove('visible');
      document.getElementById('diaryEditCard').classList.remove('visible');
      document.getElementById('editActions').classList.remove('visible');

      const nd = document.getElementById('noDiaryMsg');
      nd.classList.add('visible');
      document.getElementById('noDiaryDate').textContent = dateStr;
    }
  }

  document.getElementById('writeDiaryBtn').addEventListener('click', (e) => {
    e.preventDefault();
    if (selectedDateKey) location.href = `/write?date=${selectedDateKey}`;
  });

  document.getElementById('editBtn').addEventListener('click', () => {
    if (!currentDiaryId) return;
    const selectedEntry = document.querySelector('.diary-entry.selected');
    const content = selectedEntry ? selectedEntry.dataset.content : '';
    document.getElementById('diaryEditInput').value = content;
    document.getElementById('diaryCard').classList.remove('visible');
    document.getElementById('detailActions').classList.remove('visible');
    document.getElementById('diaryEditCard').classList.add('visible');
    document.getElementById('editActions').classList.add('visible');
    isEditMode = true;
  });

  document.getElementById('cancelBtn').addEventListener('click', exitEditMode);

  function exitEditMode() {
    isEditMode = false;
    document.getElementById('diaryEditCard').classList.remove('visible');
    document.getElementById('editActions').classList.remove('visible');
    if (currentDiaryId) {
      document.getElementById('diaryCard').classList.add('visible');
      document.getElementById('detailActions').classList.add('visible');
    } else if (diaryMap[selectedDateKey]) {
      document.getElementById('diaryCard').classList.add('visible');
    }
  }

  document.getElementById('saveBtn').addEventListener('click', async () => {
    if (!currentDiaryId) return;
    const newContent = document.getElementById('diaryEditInput').value.trim();
    if (!newContent) return;

    try {
      const res = await fetch(`/write/${currentDiaryId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: newContent }),
      });
      const result = await res.json();
      if (result.success) {
        for (const dateData of Object.values(diaryMap)) {
          const entry = dateData.entries.find(e => e.diaryId === currentDiaryId);
          if (entry) { entry.content = newContent; break; }
        }
        const selectedEntry = document.querySelector('.diary-entry.selected');
        if (selectedEntry) {
          selectedEntry.dataset.content = newContent;
          selectedEntry.querySelector('.entry-content').textContent = newContent;
        }
        exitEditMode();
      } else {
        alert('수정 실패');
      }
    } catch (err) {
      console.error(err);
      alert('수정 중 오류 발생');
    }
  });

  document.getElementById('deleteBtn').addEventListener('click', async () => {
    if (!currentDiaryId) return;
    if (!confirm('이 일기를 삭제할까요?')) return;

    try {
      const res = await fetch(`/write/${currentDiaryId}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        location.reload();
      } else {
        alert('삭제 실패');
      }
    } catch (err) {
      console.error(err);
      alert('삭제 중 오류 발생');
    }
  });

  const initDate = new Date();
  loadAndBuildCalendar(initDate.getFullYear(), initDate.getMonth() + 1);

  document.getElementById('prevBtn').addEventListener('click', () => {
    let m = currentMonth - 1, y = currentYear;
    if (m < 1) { m = 12; y--; }
    loadAndBuildCalendar(y, m);
    resetDetail();
  });
  document.getElementById('nextBtn').addEventListener('click', () => {
    let m = currentMonth + 1, y = currentYear;
    if (m > 12) { m = 1; y++; }
    loadAndBuildCalendar(y, m);
    resetDetail();
  });

  function resetDetail() {
    currentDiaryId = null;
    isEditMode = false;
    selectedDateKey = null;
    document.getElementById('detailEmpty').style.display = '';
    document.getElementById('emotionCard').classList.remove('visible');
    document.getElementById('diaryCard').classList.remove('visible');
    document.getElementById('diaryEditCard').classList.remove('visible');
    document.getElementById('detailActions').classList.remove('visible');
    document.getElementById('editActions').classList.remove('visible');
    document.getElementById('noDiaryMsg').classList.remove('visible');
  }
</script>
</body>
</html>