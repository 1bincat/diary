<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moodly - 기록하기</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/write.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="page">
    <div class="app-container">
      <%- include('partials/header') %>

      <div class="write-layout">
        <div class="write-main">
          <div class="emotion-header" style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1rem;">
            <h2 id="currentDate" style="font-family: 'Noto Sans KR', sans-serif; font-weight: 900; font-size: 1.4rem; margin: 0; color: #333; line-height: 1.4; text-align: left;"></h2>
            <div class="emotion-row" style="display: flex; gap: 0.8rem;">
              <button class="emotion-btn happy <%= (selectedEmotion === 1) ? 'selected' : '' %>" data-id="1">😊</button>
              <button class="emotion-btn calm <%= (selectedEmotion === 2) ? 'selected' : '' %>" data-id="2">😌</button>
              <button class="emotion-btn normal <%= (selectedEmotion === 3) ? 'selected' : '' %>" data-id="3">😐</button>
              <button class="emotion-btn sad <%= (selectedEmotion === 4) ? 'selected' : '' %>" data-id="4">😢</button>
              <button class="emotion-btn angry <%= (selectedEmotion === 5) ? 'selected' : '' %>" data-id="5">😠</button>
            </div>
          </div>

          <div class="write-card">
            <textarea class="write-textarea" id="diaryContent" placeholder="지금의 기분을 기록해보세요..."></textarea>
            <div class="write-footer">
              <button class="voice-btn" type="button">🎙 음성 입력</button>
              <span class="char-count"><span id="charCount">0</span> / 500자</span>
            </div>
          </div>
          
          <div class="write-actions" style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">
            <button class="cancel-btn" onclick="history.back()">취소</button>
            <button class="save-btn" id="saveBtn">기록하기</button>
          </div>

          <div class="emotion-chart-card">
            <p style="font-size: 0.9rem; font-weight: bold; color: #666; margin-bottom: 1rem;">📈 오늘의 감정 변화</p>
            <div style="height: 220px; position: relative;">
              <canvas id="emotionChart" data-diaries='<%- JSON.stringify(diaries || []) %>'></canvas>
            </div>
          </div>
        </div>

        <div class="write-side">
          <div class="side-card streak-card <%= (streak === 0) ? 'streak-broken' : '' %>">
            <p class="side-label" style="font-weight: bold; margin-bottom: 15px; color: #555;">🔥 연속 기록 중</p>
            <div class="streak-box" style="display: flex; align-items: center; gap: 15px;">
              <% if (streak > 0) { %>
                <span class="streak-num"><%= streak %></span>
                <p class="streak-text">일째 기록 중! 계속 힘내세요!</p>
              <% } else { %>
                <span class="streak-off">🔥</span>
                <p class="streak-text broken-msg">연속 기록이 깨졌어요!<br>얼른 일기를 쓰고 불을 지펴주세요!</p>
              <% } %>
            </div>
          </div>
          
          <div class="side-card timeline-card" style="margin-top: 20px;">
            <p class="side-label" style="font-weight: bold; margin-bottom: 15px; color: #555;">🕒 오늘의 타임라인</p>
            <div class="timeline-container" style="max-height: 400px; overflow-y: auto;">
              <% if (typeof diaries !== 'undefined' && diaries.length > 0) { %>
                <% diaries.forEach((item, index) => { %>
                  <div class="timeline-item" style="border-left: 2px solid #4CAF50; padding-left: 15px; margin-bottom: 20px; position: relative;">
                    <div style="position: absolute; left: -6px; top: 0; width: 10px; height: 10px; border-radius: 50%; background: #4CAF50;"></div>
                    <small style="color: #888;"><%= item.time %></small>
                    <div class="timeline-content">
                      <% if (item.content && item.content.length > 45) { %>
                        <p id="short-<%= index %>" style="word-break: break-all; margin: 5px 0;"><%= item.content.substring(0, 45) %>...<button type="button" class="toggle-btn" onclick="toggleDiary('<%= index %>', true)" style="color:#4CAF50; border:none; background:none; cursor:pointer;">더보기</button></p>
                        <p id="full-<%= index %>" style="display:none; word-break: break-all; margin: 5px 0;"><%= item.content %><button type="button" class="toggle-btn" onclick="toggleDiary('<%= index %>', false)" style="color:#4CAF50; border:none; background:none; cursor:pointer;">&nbsp;간략히</button></p>
                      <% } else { %>
                        <p style="word-break: break-all; margin: 5px 0;"><%= item.content %></p>
                      <% } %>
                    </div>
                    <span style="position: absolute; right: 0; top: 0; font-size: 1.2rem;">
                      <%= ['','😊','😌','😐','😢','😠'][item.emotion_id] %>
                    </span>
                  </div>
                <% }) %>
              <% } else { %>
                <p style="color: #bbb; text-align: center; padding: 20px 0;">오늘의 첫 기록을 남겨보세요!</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleDiary(index, show) {
      document.getElementById('short-' + index).style.display = show ? 'none' : 'block';
      document.getElementById('full-' + index).style.display = show ? 'block' : 'none';
    }

    // 초기값 설정 확인
    let selectedEmotionId = Number("<%= (typeof selectedEmotion !== 'undefined') ? selectedEmotion : 0 %>");

    document.addEventListener('DOMContentLoaded', () => {
      // --- 날짜 표시 기능 (년, 월, 일, 요일 전체 포함) ---
  const dateElement = document.getElementById('currentDate');
  
    if (dateElement) {
      const now = new Date();
      const year = now.getFullYear();           // 2026
      const month = now.getMonth() + 1;         // 4
      const date = now.getDate();               // 13
      
      // 요일 계산용 배열
      const week = ['일', '월', '화', '수', '목', '금', '토'];
      const dayOfWeek = week[now.getDay()];     // 월
      
      // 최종 출력: 2026년 4월 13일 월요일
      dateElement.innerHTML = `${year}년<br>${month}월 ${date}일 ${dayOfWeek}요일`;
    }
      const textarea = document.getElementById('diaryContent');
      const saveBtn = document.getElementById('saveBtn');

      // 1. 감정 버튼 클릭 - selectedEmotionId 업데이트 보장
      const btns = document.querySelectorAll('.emotion-btn');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedEmotionId = parseInt(btn.dataset.id); // 버튼 클릭 시 ID 갱신
        });
      });

      // 2. 글자수 체크
      textarea.addEventListener('input', () => {
        document.getElementById('charCount').textContent = textarea.value.length;
      });

      // 3. 그래프 (기존 유지)
      const canvas = document.getElementById('emotionChart');
      const diaryData = JSON.parse(canvas.getAttribute('data-diaries') || '[]');
      if (diaryData.length > 0) {
        const scores = { 1: 5, 2: 4, 3: 3, 4: 2, 5: 1 };
        new Chart(canvas.getContext('2d'), {
          type: 'line',
          data: {
            labels: diaryData.map(d => d.time),
            datasets: [{
              data: diaryData.map(d => scores[d.emotion_id]),
              borderColor: '#4CAF50',
              tension: 0.4,
              fill: true,
              backgroundColor: 'rgba(76, 175, 80, 0.1)'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                min: 1, max: 5,
                ticks: {
                  stepSize: 1,
                  callback: (v) => ({5:'😊', 4:'😌', 3:'😐', 2:'😢', 1:'😠'}[v])
                }
              }
            },
            plugins: { legend: { display: false } }
          }
        });
      }

      // 4. ★ 저장 로직 오류 수정 ★
      // 이벤트 리스너를 명확히 연결하고, fetch 요청의 응답 처리를 강화했습니다.
      if (saveBtn) {
        saveBtn.addEventListener('click', async () => {
          const content = textarea.value.trim();
          
          // 알림창으로 무엇이 빠졌는지 사용자에게 정확히 알림
          if (!content) return alert('내용을 입력해주세요.');
          if (selectedEmotionId === 0) return alert('감정을 선택해주세요.');
          
          try {
            const res = await fetch('/write', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content, emotionId: selectedEmotionId })
            });
            const data = await res.json();
            
            if (data.success) {
              window.location.reload(); // 성공 시 페이지 새로고침하여 타임라인 업데이트
            } else {
              alert('저장 실패: ' + (data.message || '알 수 없는 오류'));
            }
          } catch (err) {
            console.error('기록 저장 중 에러 발생:', err);
            alert('서버와 통신하는 중 오류가 발생했습니다.');
          }
        });
      }
    });
  </script>
</body>
</html>