<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Moodly - 캘린더</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"/>
  <link rel="stylesheet" href="/modal.css"/>
  <link rel="stylesheet" href="/calendar.css"/>
</head>
<body>

<div id="lightboxModal" class="lightbox-modal" style="display: none; position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(0, 0, 0, 0.9) !important; z-index: 9999999 !important; align-items: center; justify-content: center; user-select: none;">
  <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" style="position: absolute !important; top: 25px !important; right: 30px !important; background: none !important; border: none !important; color: #ffffff !important; font-size: 44px !important; cursor: pointer !important; z-index: 10000005 !important; line-height: 1;">✕</button>
  
  <button type="button" id="lightboxPrevBtn" class="lightbox-arrow-btn" style="display: block !important; position: absolute !important; left: 40px !important; top: 50% !important; transform: translateY(-50%) !important; background: none !important; border: none !important; color: #ffffff !important; font-size: 45px !important; font-weight: bold !important; font-family: sans-serif !important; cursor: pointer !important; z-index: 10000005 !important; padding: 10px !important; width: auto !important; height: auto !important; line-height: 1 !important; margin: 0 !important; opacity: 1 !important;">&lt;</button>
  
  <div id="lightboxViewArea" style="display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; z-index: 10000000 !important;"></div>
  
  <button type="button" id="lightboxNextBtn" class="lightbox-arrow-btn" style="display: block !important; position: absolute !important; right: 40px !important; top: 50% !important; transform: translateY(-50%) !important; background: none !important; border: none !important; color: #ffffff !important; font-size: 45px !important; font-weight: bold !important; font-family: sans-serif !important; cursor: pointer !important; z-index: 10000005 !important; padding: 10px !important; width: auto !important; height: auto !important; line-height: 1 !important; margin: 0 !important; opacity: 1 !important;">&gt;</button>
</div>

<div class="app-container">
  <%- include('partials/header') %>
</div>

<div class="cal-container">
  <div class="calendar-card">
    <div class="cal-header">
      <button class="cal-nav-btn" id="prevBtn">&#8249;</button>
      <h2 id="calTitle"></h2>
      <button class="cal-nav-btn" id="nextBtn">&#8250;</button>
    </div>
    <div class="cal-grid" id="calGrid">
      <div class="day-header sun">일</div>
      <div class="day-header">월</div>
      <div class="day-header">화</div>
      <div class="day-header">수</div>
      <div class="day-header">목</div>
      <div class="day-header">금</div>
      <div class="day-header sat">토</div>
    </div>
  </div>

  <div class="detail-panel">
    <div class="detail-empty" id="detailEmpty">날짜를 선택하면<br/>일기 내용이 표시됩니다 📖</div>

    <div class="emotion-card" id="emotionCard">
      <div class="big-emoji" id="detailEmoji"></div>
      <div class="emotion-label" id="detailEmotion"></div>
      <div class="diary-date" id="detailDate"></div>
    </div>

    <div class="diary-card" id="diaryCard">
      <h3>일기</h3>
      <div id="diaryContent"></div>
    </div>

    <div class="no-diary-msg" id="noDiaryMsg">
      <div class="date-label" id="noDiaryDate"></div>
      <a href="#" class="write-btn" id="writeDiaryBtn">+ 일기 쓰기</a>
    </div>

    <div class="detail-actions" id="detailActions">
      <button class="btn-delete" id="deleteBtn">삭제하기</button>
      <button class="btn-edit" id="editBtn">수정하기</button>
    </div>
  </div>
</div>

<script>
  const isLoggedIn = "<%= user ? 'true' : 'false' %>" === "true";
  if (!isLoggedIn) {
    window.addEventListener('load', () => {
      if (typeof openLogin === 'function') openLogin();
    });
  }

  let diaryMap = {};
  let currentYear, currentMonth;
  let currentDiaryId = null;
  let currentEmotionId = null; 
  let selectedDateKey = null;
  let selectedCell = null;

  function pad(n) { return String(n).padStart(2, '0'); }
  function toKey(y, m, d) { return `${y}-${pad(m)}-${pad(d)}`; }

  async function loadAndBuildCalendar(year, month) {
    currentYear = year;
    currentMonth = month;
    document.getElementById('calTitle').textContent = `${year}년 ${month}월`;

    try {
      const response = await fetch(`/calendar?year=${year}&month=${month}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const result = await response.json();
      diaryMap = result.diaryMap || {};
    } catch (e) {
      console.error("실시간 데이터 조회 실패:", e);
      diaryMap = {};
    }

    const grid = document.getElementById('calGrid');
    while (grid.children.length > 7) grid.removeChild(grid.lastChild);

    const firstDay = new Date(year, month - 1, 1).getDay();
    const lastDate = new Date(year, month, 0).getDate();
    const prevLastDate = new Date(year, month - 1, 0).getDate();
    const today = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth() + 1, today.getDate());

    for (let i = firstDay - 1; i >= 0; i--) {
      const pm = month - 1 === 0 ? 12 : month - 1;
      const py = month - 1 === 0 ? year - 1 : year;
      grid.appendChild(makeDayCell(py, pm, prevLastDate - i, true));
    }
    for (let d = 1; d <= lastDate; d++) {
      const cell = makeDayCell(year, month, d, false);
      if (toKey(year, month, d) === todayKey) cell.classList.add('today');
      grid.appendChild(cell);
    }
    const total = grid.children.length - 7;
    const remaining = total % 7 === 0 ? 0 : 7 - (total % 7);
    for (let d = 1; d <= remaining; d++) {
      const nm = month + 1 > 12 ? 1 : month + 1;
      const ny = month + 1 > 12 ? year + 1 : year;
      grid.appendChild(makeDayCell(ny, nm, d, true));
    }

    if (selectedDateKey) {
      const cells = grid.querySelectorAll('.day-cell:not(.other-month)');
      cells.forEach(c => {
        const parts = selectedDateKey.split('-');
        if (parseInt(c.querySelector('.day-num').textContent) === parseInt(parts[2])) {
          c.classList.add('selected');
          selectedCell = c;
        }
      });
    }
  }

  function makeDayCell(year, month, day, otherMonth) {
    const cell = document.createElement('div');
    cell.classList.add('day-cell');
    if (otherMonth) cell.classList.add('other-month');

    const dow = new Date(year, month - 1, day).getDay();
    if (dow === 0) cell.classList.add('sun');
    if (dow === 6) cell.classList.add('sat');

    const key = toKey(year, month, day);
    const numEl = document.createElement('div');
    numEl.className = 'day-num';
    numEl.textContent = day;
    cell.appendChild(numEl);

    if (diaryMap[key]) {
      const em = document.createElement('div');
      em.className = 'emoji-icon';
      em.textContent = diaryMap[key].emoji;
      cell.appendChild(em);
    }

    if (!otherMonth) {
      cell.addEventListener('click', () => selectDay(cell, key, year, month, day));
    }
    return cell;
  }

  function selectDay(cell, key, year, month, day) {
    if (selectedCell) selectedCell.classList.remove('selected');
    cell.classList.add('selected');
    selectedCell = cell;
    selectedDateKey = key;

    const dateStr = `${year}년 ${month}월 ${day}일`;
    document.getElementById('detailEmpty').style.display = 'none';

    const data = diaryMap[key];
    if (data) {
      const ec = document.getElementById('emotionCard');
      ec.classList.add('visible');
      ec.style.background = data.colorCode || '#f5f5e8';
      document.getElementById('detailEmoji').textContent = data.emoji;
      document.getElementById('detailEmotion').textContent = data.emotion;
      document.getElementById('detailDate').textContent = `${dateStr} 에 작성됨`;

      const diaryCard = document.getElementById('diaryCard');
      diaryCard.classList.add('visible');
      const diaryContent = document.getElementById('diaryContent');
      diaryContent.innerHTML = '';
      
      let hasCurrentActive = false;

      data.entries.forEach((entry, idx) => {
        if (idx > 0) {
          const hr = document.createElement('hr');
          hr.className = 'entry-divider';
          diaryContent.appendChild(hr);
        }

        const entryEl = document.createElement('div');
        entryEl.className = 'diary-entry';
        entryEl.dataset.id = entry.diaryId;
        entryEl.dataset.content = entry.content;
        entryEl.dataset.emotionId = entry.emotionId || data.entries[0].emotionId;

        const rawContent = entry.content;
        const isLong = rawContent.length > 50;
        const displayContent = isLong ? rawContent.substring(0, 50) + '...' : rawContent;

        // 🚀 [가로 스크롤 레이아웃 대개편] 첨부된 모든 미디어를 한 트랙에 넣고 가로로 횡대 나열
        let mediaHtml = '';
        if (entry.filePaths && entry.filePaths.length > 0) {
          mediaHtml += `<div class="cal-media-container">`;
          
          entry.filePaths.forEach(path => {
            const cleanName = path.split('/').pop().split('\\').pop();
            const isVideo = cleanName.match(/\.(mp4|mov|avi|wmv)$/i);
            
            mediaHtml += `<div class="cal-media-scroll-item">`;
            if (isVideo) {
              mediaHtml += `<video src="/uploads/${cleanName}" class="media-preview-item"></video>`;
              mediaHtml += `<div class="video-badge">▶</div>`; // 캘린더에서 작동 잘 되던 비디오 뱃지 유지
            } else {
              mediaHtml += `<img src="/uploads/${cleanName}" class="media-preview-item" />`;
            }
            mediaHtml += `</div>`;
          });
          
          mediaHtml += `</div>`;
        }

        entryEl.innerHTML = `
          <div class="entry-meta">
            <span>${entry.emoji} ${entry.emotion}</span>
            <span class="entry-time">${entry.time}</span>
          </div>
          ${mediaHtml}
          <div class="entry-content">${displayContent}${isLong ? `<button class="more-less-btn" type="button">더보기</button>` : ''}</div>
        `;

        if (isLong) {
          const btn = entryEl.querySelector('.more-less-btn');
          const contentDiv = entryEl.querySelector('.entry-content');
          let isOpen = false;

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (!isOpen) {
              contentDiv.innerHTML = rawContent.replace(/\n/g, '<br>') + `<button class="more-less-btn" type="button">간략히</button>`;
              isOpen = true;
            } else {
              contentDiv.innerHTML = rawContent.substring(0, 50) + '...' + `<button class="more-less-btn" type="button">더보기</button>`;
              isOpen = false;
            }
            bindToggleEvent();
          });

          function bindToggleEvent() {
            const currentBtn = entryEl.querySelector('.more-less-btn');
            currentBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              if (!isOpen) {
                contentDiv.innerHTML = rawContent.replace(/\n/g, '<br>') + `<button class="more-less-btn" type="button">간략히</button>`;
                isOpen = true;
              } else {
                contentDiv.innerHTML = rawContent.substring(0, 50) + '...' + `<button class="more-less-btn" type="button">더보기</button>`;
                isOpen = false;
              }
              bindToggleEvent();
            });
          }
        }

        if (currentDiaryId && parseInt(entry.diaryId) === parseInt(currentDiaryId)) {
          entryEl.classList.add('selected');
          hasCurrentActive = true;
        }

        entryEl.addEventListener('click', () => {
          diaryContent.querySelectorAll('.diary-entry').forEach(el => el.classList.remove('selected'));
          entryEl.classList.add('selected');
          currentDiaryId = entry.diaryId;
          currentEmotionId = entry.emotionId; 
          document.getElementById('detailActions').classList.add('visible');
        });

        diaryContent.appendChild(entryEl);
      });

      if (hasCurrentActive) {
        document.getElementById('detailActions').classList.add('visible');
      } else {
        document.getElementById('detailActions').classList.remove('visible');
      }
      
      document.getElementById('noDiaryMsg').classList.remove('visible');

    } else {
      currentDiaryId = null;
      document.getElementById('emotionCard').classList.remove('visible');
      document.getElementById('diaryCard').classList.remove('visible');
      document.getElementById('detailActions').classList.remove('visible');

      const nd = document.getElementById('noDiaryMsg');
      nd.classList.add('visible');
      document.getElementById('noDiaryDate').textContent = dateStr;
    }
  }

  document.getElementById('writeDiaryBtn').addEventListener('click', (e) => {
    e.preventDefault();
    if (selectedDateKey) location.href = `/write?date=${selectedDateKey}`;
  });

  document.getElementById('editBtn').addEventListener('click', () => {
    if (!currentDiaryId || !selectedDateKey) return;
    location.href = `/write?date=${selectedDateKey}&editId=${currentDiaryId}`;
  });

  document.getElementById('deleteBtn').addEventListener('click', async () => {
    if (!currentDiaryId) return;
    if (!confirm('이 일기를 삭제할까요?')) return;

    try {
      const res = await fetch(`/write/${currentDiaryId}`, { method: 'DELETE' });
      const result = await res.json();
      
      if (result.success) {
        if (diaryMap[selectedDateKey]) {
          diaryMap[selectedDateKey].entries = diaryMap[selectedDateKey].entries.filter(
            e => parseInt(e.diaryId) !== parseInt(currentDiaryId)
          );

          if (diaryMap[selectedDateKey].entries.length > 0) {
            diaryMap[selectedDateKey].emoji = diaryMap[selectedDateKey].entries[0].emoji;
            diaryMap[selectedDateKey].emotion = diaryMap[selectedDateKey].entries[0].emotion;
          } else {
            delete diaryMap[selectedDateKey];
          }
        }

        const activeYear = currentYear;
        const activeMonth = currentMonth;
        const activeKey = selectedDateKey;
        const activeCell = selectedCell;

        await loadAndBuildCalendar(activeYear, activeMonth);

        currentDiaryId = null;
        const parts = activeKey.split('-');
        selectDay(activeCell, activeKey, parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2]));

      } else {
        alert('삭제 실패');
      }
    } catch (err) {
      console.error(err);
      alert('삭제 중 오류 발생');
    }
  });

  const initDate = new Date();
  loadAndBuildCalendar(initDate.getFullYear(), initDate.getMonth() + 1);

  document.getElementById('prevBtn').addEventListener('click', () => {
    let m = currentMonth - 1, y = currentYear;
    if (m < 1) { m = 12; y--; }
    loadAndBuildCalendar(y, m);
    resetDetail();
  });
  document.getElementById('nextBtn').addEventListener('click', () => {
    let m = currentMonth + 1, y = currentYear;
    if (m > 12) { m = 1; y++; }
    loadAndBuildCalendar(y, m);
    resetDetail();
  });

  function resetDetail() {
    currentDiaryId = null;
    selectedDateKey = null;
    document.getElementById('detailEmpty').style.display = '';
    document.getElementById('emotionCard').classList.remove('visible');
    document.getElementById('diaryCard').classList.remove('visible');
    document.getElementById('detailActions').classList.remove('visible');
    document.getElementById('noDiaryMsg').classList.remove('visible');
  }

  // 라이트박스 갤러리 작동 자바스크립트
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightboxModal');
    const viewArea = document.getElementById('lightboxViewArea');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const prevBtn = document.getElementById('lightboxPrevBtn');
    const nextBtn = document.getElementById('lightboxNextBtn');

    let currentLightboxMediaArray = [];
    let currentLightboxIndex = 0;

    function updateArrowStates() {
      if (currentLightboxMediaArray.length <= 1) {
        prevBtn.style.setProperty('display', 'none', 'important');
        nextBtn.style.setProperty('display', 'none', 'important');
        return;
      }
      
      prevBtn.style.setProperty('display', 'block', 'important');
      nextBtn.style.setProperty('display', 'block', 'important');

      if (currentLightboxIndex === 0) {
        prevBtn.style.opacity = '0.15';
        prevBtn.style.cursor = 'not-allowed';
        prevBtn.style.pointerEvents = 'none';
      } else {
        prevBtn.style.opacity = '1';
        prevBtn.style.cursor = 'pointer';
        prevBtn.style.pointerEvents = 'auto';
      }

      if (currentLightboxIndex === currentLightboxMediaArray.length - 1) {
        nextBtn.style.opacity = '0.15';
        nextBtn.style.cursor = 'not-allowed';
        nextBtn.style.pointerEvents = 'none';
      } else {
        nextBtn.style.opacity = '1';
        nextBtn.style.cursor = 'pointer';
        nextBtn.style.pointerEvents = 'auto';
      }
    }

    function renderLightboxContent() {
      if (currentLightboxMediaArray.length === 0) return;
      const src = currentLightboxMediaArray[currentLightboxIndex];
      const isVideo = src.match(/\.(mp4|mov|avi|wmv)/i);

      if (isVideo) {
        viewArea.innerHTML = `<video src="${src}" controls class="lightbox-content" autoplay style="max-width: 85% !important; max-height: 80vh !important; object-fit: contain !important; border-radius: 12px; box-shadow: 0 4px 30px rgba(0,0,0,0.5);"></video>`;
      } else {
        viewArea.innerHTML = `<img src="${src}" class="lightbox-content" style="max-width: 85% !important; max-height: 80vh !important; object-fit: contain !important; border-radius: 12px; box-shadow: 0 4px 30px rgba(0,0,0,0.5);" />`;
      }
      updateArrowStates();
    }

    function openLightbox(mediaSrcList, startIndex) {
      currentLightboxMediaArray = mediaSrcList;
      currentLightboxIndex = startIndex;
      
      renderLightboxContent();
      
      lightbox.style.setProperty('display', 'flex', 'important'); 
      lightbox.classList.add('show');
      document.body.style.overflow = 'hidden'; 
    }

    function closeLightbox() {
      lightbox.style.setProperty('display', 'none', 'important');
      lightbox.classList.remove('show');
      document.body.style.overflow = ''; 
      currentLightboxMediaArray = [];
      currentLightboxIndex = 0;
      setTimeout(() => { viewArea.innerHTML = ''; }, 150); 
    }

    function moveLeft() {
      if (currentLightboxIndex > 0) {
        currentLightboxIndex--;
        renderLightboxContent();
      }
    }

    function moveRight() {
      if (currentLightboxIndex < currentLightboxMediaArray.length - 1) {
        currentLightboxIndex++;
        renderLightboxContent();
      }
    }

    // 🚀 가로 갤러리 내 아이템 클릭 추적 엔진 보정
    document.body.addEventListener('click', (e) => {
      if (e.target.classList.contains('media-preview-item')) {
        const container = e.target.closest('.cal-media-container');
        if (container) {
          e.stopPropagation();
          const allMediaNodes = Array.from(container.querySelectorAll('.media-preview-item'));
          const mediaSrcList = allMediaNodes.map(node => node.src);
          const clickIndex = allMediaNodes.indexOf(e.target);

          openLightbox(mediaSrcList, clickIndex >= 0 ? clickIndex : 0);
        }
      }
    });

    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); moveLeft(); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); moveRight(); });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('show')) return;

      if (e.key === 'ArrowRight') {
        e.preventDefault();
        moveRight();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        moveLeft();
      } else if (e.key === 'Escape') {
        closeLightbox();
      }
    });

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === viewArea) closeLightbox();
    });
  });
</script>
</body>
</html>