<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MOODLY - 로그인</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/modal.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">

      <h1 class="auth-logo">MOODLY</h1>
      <p class="auth-title">로그인</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="auth-error"><%= error %></p>
      <% } %>

      <form action="/login" method="POST" class="auth-form">
        <div class="field-group">
          <label class="field-label" for="username">아이디</label>
          <input class="field-input" type="text" id="username" name="username" autocomplete="username" />
        </div>

        <div class="field-group">
          <div class="field-label-row">
            <label class="field-label" for="password">비밀번호</label>
            <a class="forgot-link" href="#">비밀번호 찾기</a>
          </div>
          <input class="field-input" type="password" id="password" name="password" autocomplete="current-password" />
        </div>

        <button class="auth-btn" type="submit">로그인</button>
      </form>

      <p class="auth-footer">
        아직 계정이 없으신가요?&nbsp;<a href="/signup">회원가입하기</a>
      </p>

    </div>
  </div>
</body>
</html>
