<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moodly</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/write.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div id="lightboxModal" class="lightbox-modal">
    <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn">✕</button>
    <button type="button" id="lightboxPrevBtn" class="lightbox-arrow-btn">&lt;</button>
    <div id="lightboxViewArea"></div>
    <button type="button" id="lightboxNextBtn" class="lightbox-arrow-btn">&gt;</button>
  </div>

  <div id="aiRecommendationModal">
    <div class="ai-popup-body">
      <h3 class="ai-popup-title">✨AI 감정 케어 리포트✨</h3>
      
      <div class="ai-popup-container">
        <div class="ai-popup-card-item msg-box">
          <small>오늘의 한마디</small>
          <span id="pop-message">분석 중...</span>
        </div>
        <div class="ai-popup-card-item act-box">
          <small>추천 행동 가이드</small>
          <span id="pop-action">분석 중...</span>
        </div>
        <div class="ai-popup-card-item mus-box">
          <small>내 마음을 채울 음악</small>
          <span id="pop-music">분석 중...</span>
        </div>
      </div>
      
      <button type="button" id="aiPopCloseBtn">확인 완료</button>
    </div>
  </div>

  <div id="aiBubblePopover" class="ai-bubble-popover" style="display: none;"> <div class="ai-bubble-item bubble-msg">
      <small>오늘의 한마디</small>
      <p id="bub-message">-</p>
    </div>
    <div class="ai-bubble-item bubble-act">
      <small>추천 행동</small>
      <p id="bub-action">-</p>
    </div>
    <div class="ai-bubble-item bubble-mus">
      <small>추천 음악</small>
      <p id="bub-music">-</p>
    </div>
  </div>

  <div class="page">
    <div class="app-container">
      <%- include('partials/header') %>

      <div class="write-layout">
        <div class="write-main">
          <div class="emotion-header">
            <h2 id="currentDate"></h2>
            <div class="emotion-row">
              <button class="emotion-btn happy" data-id="1">😊</button>
              <button class="emotion-btn calm" data-id="2">😌</button>
              <button class="emotion-btn normal" data-id="3">😐</button>
              <button class="emotion-btn sad" data-id="4">😢</button>
              <button class="emotion-btn angry" data-id="5">😡</button>
            </div>
          </div>

          <div class="write-card">
            <textarea class="write-textarea" id="diaryContent" placeholder="지금의 기분을 기록해보세요..."></textarea>
            <div class="media-preview-container" id="mediaPreviewContainer"></div>

            <div class="write-card-footer">
              <div class="footer-left">
                <button class="voice-btn" type="button">🎙 음성 입력</button>
                <label for="mediaFileInput" class="media-upload-label">🔗 파일 첨부</label>
                <input type="file" id="mediaFileInput" accept="image/*, video/*" multiple style="display: none;" />
              </div>
              <div class="footer-right">
                <span class="char-count"><span id="charCount">0</span> / 500자</span>
              </div>
            </div>
          </div>
          
          <div class="write-actions">
            <button class="cancel-btn" onclick="history.back()">취소</button>
            <button class="save-btn" id="saveBtn">기록하기</button>
          </div>

          <div class="emotion-chart-card">
            <p>📈 오늘의 감정 변화</p>
            <div class="chart-wrapper-box">
              <canvas id="emotionChart" data-diaries='<%- JSON.stringify(diaries || []) %>'></canvas>
            </div>
          </div>
        </div>

        <div class="write-side">
          <div class="side-card streak-card <%= (streak === 0) ? 'streak-broken' : '' %>">
            <p class="side-label">🔥 연속 기록 중</p>
            <div class="streak-box">
              <% if (streak > 0) { %>
                <span class="streak-num"><%= streak %></span>
                <p class="streak-text">일째 기록 중! 계속 힘내세요!</p>
              <% } else { %>
                <span class="streak-off">🔥</span>
                <p class="streak-text broken-msg">연속 기록이 깨졌어요!<br>얼른 일기를 쓰고 불을 지펴주세요!</p>
              <% } %>
            </div>
          </div>
          
          <div class="side-card timeline-card">
            <p class="side-label">🕒 오늘의 타임라인</p>
            <div class="timeline-container">
              <% if (typeof diaries !== 'undefined' && diaries.length > 0) { %>
                <% diaries.forEach((item, index) => { %>
                  <div class="timeline-item">
                    <div class="timeline-item-bullet"></div>
                    <small><%= item.time %></small>
                    
                    <% if (item.file_paths && item.file_paths.length > 0) { %>
                      <div class="cal-media-container">
                        <% item.file_paths.forEach(path => { %>
                          <% 
                            const cleanName = path.split('/').pop().split('\\').pop(); 
                            const isVideo = cleanName.match(/\.(mp4|mov|avi|wmv)$/i);
                          %>
                          <div class="cal-media-scroll-item">
                            <% if (isVideo) { %>
                              <video src="/uploads/<%= cleanName %>" class="media-preview-item"></video>
                              <div class="video-badge">▶</div>
                            <% } else { %>
                              <img src="/uploads/<%= cleanName %>" class="media-preview-item" />
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>

                    <div class="timeline-content">
                      <% if (item.content && item.content.length > 45) { %>
                        <p id="short-<%= index %>"><%= item.content.substring(0, 45) %>...<button type="button" class="toggle-btn" onclick="toggleDiary('<%= index %>', true)">더보기</button></p>
                        <p id="full-<%= index %>" style="display:none;"><%= item.content %><button type="button" class="toggle-btn" onclick="toggleDiary('<%= index %>', false)">&nbsp;간략히</button></p>
                      <% } else { %>
                        <p><%= item.content %></p>
                      <% } %>
                    </div>

                    <span class="timeline-emoji-btn" 
                          data-message="<%= item.ai_message || '' %>" 
                          data-action="<%= item.ai_action || '' %>" 
                          data-music="<%= item.ai_music || '' %>">
                      <%= ['','😊','😌','😐','😢','😡'][item.emotion_id] %>
                    </span>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="broken-msg" style="text-align: center; padding: 20px 0;">오늘의 첫 기록을 남겨보세요!</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleDiary(index, show) {
      document.getElementById('short-' + index).style.display = show ? 'none' : 'block';
      document.getElementById('full-' + index).style.display = show ? 'block' : 'none';
    }

    const editData = <%- JSON.stringify(typeof editData !== 'undefined' ? editData : null) %>;
    let selectedEmotionId = editData ? editData.emotion_id : Number("<%= (typeof selectedEmotion !== 'undefined') ? selectedEmotion : 0 %>");
    const displayDateStr = "<%= displayDate %>";
    
    let selectedNewFiles = [];
    let existingFiles = editData ? (editData.file_path ? editData.file_path.split(',') : []) : [];

    document.addEventListener('DOMContentLoaded', () => {
      const dateElement = document.getElementById('currentDate');
      if (dateElement && displayDateStr) {
        const p = displayDateStr.split('-');
        const dateObj = new Date(p[0], p[1]-1, p[2]);
        const week = ['일', '월', '화', '수', '목', '금', '토'];
        
        if (editData) {
          dateElement.innerHTML = `${p[0]}년 ${parseInt(p[1])}월 ${parseInt(p[2])}일<br><span style="color:#6b8f5e; font-size:1.1rem;">일기 수정 중... ✏️</span>`;
          document.getElementById('saveBtn').textContent = '수정 완료';
        } else {
          dateElement.innerHTML = `${p[0]}년<br>${parseInt(p[1])}월 ${parseInt(p[2])}일 ${week[dateObj.getDay()]}요일`;
        }
      }

      const textarea = document.getElementById('diaryContent');
      const saveBtn = document.getElementById('saveBtn');
      const mediaFileInput = document.getElementById('mediaFileInput');
      const mediaPreviewContainer = document.getElementById('mediaPreviewContainer');

      function refreshMultiPreviews() {
        mediaPreviewContainer.innerHTML = '';
        if (existingFiles.length === 0 && selectedNewFiles.length === 0) {
          mediaPreviewContainer.style.display = 'none';
          return;
        }
        mediaPreviewContainer.style.display = 'flex';

        existingFiles.forEach((path, idx) => {
          if (!path) return;
          const cleanName = path.split('/').pop().split('\\').pop();
          const wrapper = document.createElement('div');
          wrapper.className = 'preview-wrapper';
          
          if (cleanName.match(/\.(mp4|mov|avi|wmv)$/i)) {
            wrapper.innerHTML = `
              <video src="/uploads/${cleanName}" class="media-preview-item"></video>
              <div class="video-badge" style="position: absolute !important; bottom: 4px !important; right: 4px !important; background: rgba(0, 0, 0, 0.6) !important; color: #ffffff !important; font-size: 8px !important; padding: 1px 3px !important; border-radius: 2px !important; font-weight: bold !important; pointer-events: none !important; line-height: 1 !important; z-index: 2;">▶</div>
              <button type="button" class="remove-preview-btn">✕</button>
            `;
          } else {
            wrapper.innerHTML = `
              <img src="/uploads/${cleanName}" class="media-preview-item" />
              <button type="button" class="remove-preview-btn">✕</button>
            `;
          }
          wrapper.querySelector('.remove-preview-btn').addEventListener('click', () => {
            existingFiles.splice(idx, 1);
            refreshMultiPreviews();
          });
          mediaPreviewContainer.appendChild(wrapper);
        });

        selectedNewFiles.forEach((file, idx) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'preview-wrapper';
          
          const reader = new FileReader();
          reader.onload = (e) => {
            if (file.type.startsWith('video/')) {
              wrapper.innerHTML = `
                <video src="${e.target.result}" class="media-preview-item"></video>
                <div class="video-badge" style="position: absolute !important; bottom: 4px !important; right: 4px !important; background: rgba(0, 0, 0, 0.6) !important; color: #ffffff !important; font-size: 8px !important; padding: 1px 3px !important; border-radius: 2px !important; font-weight: bold !important; pointer-events: none !important; line-height: 1 !important; z-index: 2;">▶</div>
                <button type="button" class="remove-preview-btn">✕</button>
              `;
            } else {
              wrapper.innerHTML = `
                <img src="${e.target.result}" class="media-preview-item" />
                <button type="button" class="remove-preview-btn">✕</button>
              `;
            }
            wrapper.querySelector('.remove-preview-btn').addEventListener('click', () => {
              selectedNewFiles.splice(idx, 1);
              refreshMultiPreviews();
            });
          };
          reader.readAsDataURL(file);
          mediaPreviewContainer.appendChild(wrapper);
        });
      }

      if (editData) {
        textarea.value = editData.content;
        document.getElementById('charCount').textContent = editData.content.length;
        refreshMultiPreviews();
      }

      const btns = document.querySelectorAll('.emotion-btn');
      if (selectedEmotionId > 0) {
        const targetBtn = document.querySelector(`.emotion-btn[data-id="${selectedEmotionId}"]`);
        if (targetBtn) targetBtn.classList.add('selected');
      }

      mediaFileInput.addEventListener('change', () => {
        const files = Array.from(mediaFileInput.files);
        files.forEach(file => { selectedNewFiles.push(file); });
        mediaFileInput.value = ''; 
        refreshMultiPreviews();
      });

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedEmotionId = parseInt(btn.dataset.id);
        });
      });

      textarea.addEventListener('input', () => {
        document.getElementById('charCount').textContent = textarea.value.length;
      });

      const canvas = document.getElementById('emotionChart');
      const diaryData = JSON.parse(canvas.getAttribute('data-diaries') || '[]');
      if (diaryData.length > 0) {
        const scores = { 1: 5, 2: 4, 3: 3, 4: 2, 5: 1 };
        new Chart(canvas.getContext('2d'), {
          type: 'line',
          data: {
            labels: diaryData.map(d => d.time),
            datasets: [{
              data: diaryData.map(d => scores[d.emotion_id]),
              borderColor: '#4CAF50',
              tension: 0.4,
              fill: true,
              backgroundColor: 'rgba(76, 175, 80, 0.1)'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: { min: 1, max: 5, ticks: { stepSize: 1, callback: (v) => ({5:'😊', 4:'😌', 3:'😐', 2:'😢', 1:'😠'}[v]) } }
            },
            plugins: { legend: { display: false } }
          }
        });
      }

      const voiceBtn = document.querySelector('.voice-btn');
      let isRecognizing = false;
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SpeechRecognition) {
        const recognition = new SpeechRecognition();
        recognition.lang = 'ko-KR';
        recognition.interimResults = false;

        voiceBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (isRecognizing) { recognition.stop(); } else { try { recognition.start(); } catch (err) { console.error(err); } }
        });
        recognition.onstart = () => { isRecognizing = true; voiceBtn.style.backgroundColor = '#666'; voiceBtn.style.color = '#fff'; voiceBtn.textContent = '⏹ 중단하기'; };
        recognition.onresult = (event) => {
          const transcript = event.results[0][0].transcript;
          const diaryArea = document.getElementById('diaryContent');
          if (diaryArea) {
            diaryArea.value = diaryArea.value + (diaryArea.value ? " " : "") + transcript;
            if (document.getElementById('charCount')) document.getElementById('charCount').textContent = diaryArea.value.length;
          }
        };
        recognition.onend = () => { isRecognizing = false; voiceBtn.style.backgroundColor = ''; voiceBtn.style.color = ''; voiceBtn.textContent = '🎙 음성 입력'; };
        recognition.onerror = () => { isRecognizing = false; };
      } else { voiceBtn.style.display = 'none'; }

      if (saveBtn) {
        saveBtn.addEventListener('click', async () => {
          const content = textarea.value.trim();
          if (!content) return alert('내용을 입력해주세요.');
          if (selectedEmotionId === 0) return alert('감정을 선택해주세요.');
          
          try {
            const formData = new FormData();
            formData.append('content', content);
            formData.append('emotionId', selectedEmotionId);
            formData.append('date', displayDateStr);
            
            if (editData) {
              formData.append('keptFiles', existingFiles.join(','));
            }
            selectedNewFiles.forEach(file => { formData.append('mediaFiles', file); });

            let url = '/write'; 
            let method = 'POST';
            
            if (editData) { 
              url = `/write/${editData.id}`; 
              method = 'PUT'; 
            }

            saveBtn.disabled = true;
            saveBtn.textContent = '분석중...';

            const res = await fetch(url, { method: method, body: formData });
            const data = await res.json();
            
            if (data.success) {
              if (editData) {
                alert('일기가 성공적으로 수정되었습니다!');
                location.href = '/calendar';
              } else {
                document.getElementById('pop-message').textContent = data.aiRecommendation.message;
                document.getElementById('pop-action').textContent = data.aiRecommendation.action;
                document.getElementById('pop-music').textContent = data.aiRecommendation.music;
                
                document.getElementById('aiRecommendationModal').style.display = 'flex';
              }
            } else {
              alert('처리 실패: ' + (data.message || '알 수 없는 오류'));
              saveBtn.disabled = false;
              saveBtn.textContent = editData ? '수정 완료' : '기록하기';
            }
          } catch (err) {
            console.error(err);
            alert('서버 통신 오류');
            saveBtn.disabled = false;
            saveBtn.textContent = editData ? '수정 완료' : '기록하기';
          }
        });
      }

      document.getElementById('aiPopCloseBtn').addEventListener('click', () => {
        document.getElementById('aiRecommendationModal').style.display = 'none';
        window.location.reload(); 
      });

// 🚀 [초정밀 말풍선 조준 스크립트 모듈 이식 - 실시간 스크롤 추적 버전]
      const popover = document.getElementById('aiBubblePopover');
      const bubMsg = document.getElementById('bub-message');
      const bubAct = document.getElementById('bub-action');
      const bubMus = document.getElementById('bub-music');
      let currentActiveBtn = null; // 현재 열려있는 말풍선의 이모지 버튼 기억

      // 말풍선 위치를 실시간으로 업데이트해주는 함수
      function updatePopoverPosition() {
        if (!currentActiveBtn || popover.style.display !== 'flex') return;

        // 이모지 단추의 현재 브라우저 화면 상의 절대 위치(Viewport 기준)를 실시간 계산
        const rect = currentActiveBtn.getBoundingClientRect();

        // 📐 fixed 속성이므로 scrollTop 유동치 계산 없이 현재 눈에 보이는 rect 좌표만 활용!
        popover.style.top = `${rect.top - (popover.offsetHeight / 2) + (rect.height / 2)}px`;
        popover.style.left = `${rect.right + 12}px`;
      }

      document.querySelectorAll('.timeline-emoji-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation(); // 부모 항목 전파 방지

          // 만약 이미 열려있는 이모지를 또 누르면 닫히게 처리
          if (currentActiveBtn === btn && popover.style.display === 'flex') {
            popover.style.display = 'none';
            currentActiveBtn = null;
            return;
          }

          currentActiveBtn = btn; // 현재 어떤 버튼이 활성화되었는지 저장

          const msg = btn.getAttribute('data-message');
          const act = btn.getAttribute('data-action');
          const mus = btn.getAttribute('data-music');

          // 데이터가 없는 오늘 날짜 초과 에러 방지 방어 코드
          if (!msg && !act && !mus) {
            bubMsg.textContent = "내일부터 한도가 풀리면 이곳에 AI 추천 내용이 각인됩니다! ✨";
            bubAct.textContent = "테스트용 행동 가이드 완료";
            bubMus.textContent = "테스트용 추천 음반 골인";
          } else {
            bubMsg.textContent = msg || '기록된 한마디가 없습니다.';
            bubAct.textContent = act || '기록된 추천 행동이 없습니다.';
            bubMus.textContent = mus || '기록된 추천 음악이 없습니다.';
          }

          popover.style.display = 'flex';
          updatePopoverPosition(); // 클릭 시 즉시 위치 조준
        });
      });

      // 🔄 유저가 오른쪽 타임라인 내부 스크롤을 내릴 때 말풍선 위치도 실시간 갱신!
      const timelineContainer = document.querySelector('.timeline-container');
      if (timelineContainer) {
        timelineContainer.addEventListener('scroll', updatePopoverPosition);
      }

      // 🔄 혹시 브라우저 창 전체 스크롤이 발생해도 위치 실시간 갱신!
      window.addEventListener('scroll', updatePopoverPosition);

      // 유저가 말풍선 외부의 빈 화면을 아무 데나 누르면 말풍선이 자연스럽게 닫히는 UX 닫기 마법 적용
      document.addEventListener('click', (e) => {
        if (popover.style.display === 'flex' && !popover.contains(e.target)) {
          popover.style.display = 'none';
          currentActiveBtn = null;
        }
      });

      const lightbox = document.getElementById('lightboxModal');
      const viewArea = document.getElementById('lightboxViewArea');
      const closeBtn = document.getElementById('lightboxCloseBtn');
      const prevBtn = document.getElementById('lightboxPrevBtn');
      const nextBtn = document.getElementById('lightboxNextBtn');

      let currentLightboxMediaArray = [];
      let currentLightboxIndex = 0;

      function updateArrowStates() {
        if (currentLightboxMediaArray.length <= 1) {
          prevBtn.style.setProperty('display', 'none', 'important');
          nextBtn.style.setProperty('display', 'none', 'important');
          return;
        }
        prevBtn.style.setProperty('display', 'block', 'important');
        nextBtn.style.setProperty('display', 'block', 'important');
        if (currentLightboxIndex === 0) {
          prevBtn.style.opacity = '0.15'; prevBtn.style.cursor = 'not-allowed'; prevBtn.style.pointerEvents = 'none';
        } else {
          prevBtn.style.opacity = '1'; prevBtn.style.cursor = 'pointer'; prevBtn.style.pointerEvents = 'auto';
        }

        if (currentLightboxIndex === currentLightboxMediaArray.length - 1) {
          nextBtn.style.opacity = '0.15'; nextBtn.style.cursor = 'not-allowed'; nextBtn.style.pointerEvents = 'none';
        } else {
          nextBtn.style.opacity = '1'; nextBtn.style.cursor = 'pointer'; nextBtn.style.pointerEvents = 'auto';
        }
      }

      function renderLightboxContent() {
        if (currentLightboxMediaArray.length === 0) return;
        const src = currentLightboxMediaArray[currentLightboxIndex];
        const isVideo = src.match(/\.(mp4|mov|avi|wmv)/i) || src.startsWith('data:video/');
        if (isVideo) {
          viewArea.innerHTML = `<video src="${src}" controls class="lightbox-content" autoplay style="max-width: 85% !important; max-height: 80vh !important; object-fit: contain !important; border-radius: 12px; box-shadow: 0 4px 30px rgba(0,0,0,0.5); z-index: 10000002 !important;"></video>`;
        } else {
          viewArea.innerHTML = `<img src="${src}" class="lightbox-content" style="max-width: 85% !important; max-height: 80vh !important; object-fit: contain !important; border-radius: 12px; box-shadow: 0 4px 30px rgba(0,0,0,0.5); z-index: 10000002 !important;" />`;
        }
        updateArrowStates();
      }

      function openLightbox(mediaSrcList, startIndex) {
        currentLightboxMediaArray = mediaSrcList;
        currentLightboxIndex = startIndex;
        renderLightboxContent();
        lightbox.style.setProperty('display', 'flex', 'important'); 
        lightbox.classList.add('show');
        document.body.style.overflow = 'hidden';
      }

      function deleteLightbox() {
        lightbox.style.setProperty('display', 'none', 'important');
        lightbox.classList.remove('show');
        document.body.style.overflow = ''; 
        currentLightboxMediaArray = []; currentLightboxIndex = 0;
        setTimeout(() => { viewArea.innerHTML = ''; }, 150);
      }

      function moveLeft() { if (currentLightboxIndex > 0) { currentLightboxIndex--; renderLightboxContent(); } }
      function moveRight() { if (currentLightboxIndex < currentLightboxMediaArray.length - 1) { currentLightboxIndex++; renderLightboxContent(); } }

      document.body.addEventListener('click', (e) => {
        const targetTag = e.target.tagName;
        if (targetTag === 'IMG' || targetTag === 'VIDEO') {
          const container = e.target.closest('.cal-media-container') || e.target.closest('#mediaPreviewContainer') || e.target.closest('.preview-wrapper');
          if (container) {
            e.stopPropagation();
            if (targetTag === 'VIDEO' && (e.offsetX >= e.target.clientWidth * 0.8 || e.offsetY >= e.target.clientHeight * 0.8)) return;

            const allMediaNodes = Array.from(container.querySelectorAll('.media-preview-item, .preview-wrapper img, .preview-wrapper video'));
            const mediaSrcList = allMediaNodes.map(node => node.src).filter(src => src);
            const clickIndex = allMediaNodes.indexOf(e.target);

            if (mediaSrcList.length > 0) { openLightbox(mediaSrcList, clickIndex >= 0 ? clickIndex : 0); }
          }
        }
      });

      prevBtn.addEventListener('click', (e) => { e.stopPropagation(); moveLeft(); });
      nextBtn.addEventListener('click', (e) => { e.stopPropagation(); moveRight(); });

      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('show')) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); moveRight(); } 
        else if (e.key === 'ArrowLeft') { e.preventDefault(); moveLeft(); } 
        else if (e.key === 'Escape') { deleteLightbox(); }
      });
      if (closeBtn) closeBtn.addEventListener('click', deleteLightbox);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox || e.target === viewArea) deleteLightbox(); });
    });
  </script>
</body>
</html>